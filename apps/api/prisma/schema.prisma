// =============================================================================
// NanoProof Protocol — Prisma Schema (Phase 2 — Creator Registry)
//
// Migration: V1 -> V2 (adds Organization, ApiKey, IdempotencyKey,
// VerificationChallenge, SourceVerification, plus indices + cascades).
//
// Phase 0 / MVP drop shipped V1 with Creator, Wallet, Source, Citation,
// Payment. Phase 2 lands the org+apikey table + verification flows.
//
// Append-only tables (Citations, Payments) are enforced at the service
// layer; we rely on convention + Postgres triggers (see migration SQL).
//
// IMPORTANT: `previewFeatures = ["driverAdapters"]` is required so the
// PrismaClient can use the `pg` driver adapter (apps/api/src/prisma/
// prisma.service.ts) instead of the native query engine. The native
// engine (.so.node) is prebuilt for specific CPU+libc combinations and
// fails to dlopen on platforms that don't match (Termux, musl-based
// containers, etc.). The pg adapter is pure JS and works everywhere.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum WalletNetwork {
  ARC_TESTNET
  ARC_MAINNET
  BASE
  BASE_SEPOLIA
  ETHEREUM
  ETHEREUM_SEPOLIA
  POLYGON
  POLYGON_AMOY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum SourceStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum SourceVerificationMethod {
  DNS_TXT
  HTML_META
  FILE_UPLOAD
  MANUAL
}

enum CitationKind {
  DIRECT
  INDIRECT
  SUPPORTING
  REFERENCE
  CONTEXT
}

enum PaymentStatus {
  PENDING
  QUOTED
  SETTLED
  CAPPED
  FAILED
}

enum ApiKeyScope {
  READ_CITATIONS
  WRITE_CITATIONS
  READ_PAYMENTS
  WRITE_PAYMENTS
  ADMIN
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// -----------------------------------------------------------------------------
// Creator
// -----------------------------------------------------------------------------

model Creator {
  id              String  @id @default(cuid()) // cr_<ulid>
  name            String
  username        String  @unique
  email           String  @unique
  bio             String?
  avatarUrl       String?
  reputationScore Int     @default(0)
  isActive        Boolean @default(true)

  twitterHandle String?
  githubHandle  String?
  websiteUrl    String?
  settings      Json    @default("{}")

  // GDPR (P2-020): soft-delete purged after 30d
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  purgedAt  DateTime?

  // Relations
  organizationMemberships OrganizationMembership[]
  wallets                 Wallet[]
  sources                 Source[]
  citations               Citation[]               @relation("CreatorCitations")
  payments                Payment[]                @relation("CreatorPayments")
  paymentRequests         PaymentRequest[]         @relation("CreatorPaymentRequests")
  apiKeys                 ApiKey[]

  @@index([username])
  @@index([email])
  @@index([reputationScore])
  @@index([deletedAt])
  @@map("creators")
}

// -----------------------------------------------------------------------------
// Organization + Membership
// -----------------------------------------------------------------------------

model Organization {
  id           String  @id @default(cuid()) // org_<ulid>
  name         String
  slug         String  @unique
  bio          String?
  avatarUrl    String?
  websiteUrl   String?
  billingEmail String?
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships OrganizationMembership[]
  apiKeys     ApiKey[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMembership {
  id             String                 @id @default(cuid()) // mem_<ulid>
  organizationId String
  creatorId      String
  role           OrganizationMemberRole @default(VIEWER)
  invitedAt      DateTime               @default(now())
  acceptedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, creatorId])
  @@index([creatorId])
  @@map("organization_memberships")
}

// -----------------------------------------------------------------------------
// Wallet (EIP-191 verified in Phase 2 P2-009)
// -----------------------------------------------------------------------------

model Wallet {
  id        String        @id @default(cuid()) // wl_<ulid>
  creatorId String
  address   String
  network   WalletNetwork
  label     String?
  isPrimary Boolean       @default(false)

  // Verification (EIP-191 challenge/response)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verificationMethod String? // "EIP-191"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator                Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  verificationChallenges VerificationChallenge[]

  // One Creator can only have ONE primary Wallet per network.
  // Enforced by partial unique index in the migration SQL.
  @@unique([address, network])
  @@index([creatorId])
  @@index([verificationStatus])
  @@map("wallets")
}

model VerificationChallenge {
  id        String             @id @default(cuid()) // vch_<ulid>
  walletId  String
  challenge String             @unique // random nonce stored plaintext, signed by wallet
  message   String // human-readable EIP-191 message
  purpose   String // "WALLET_OWNERSHIP" (Phase 2) | "SOURCE_OWNERSHIP" (P2-012)
  status    VerificationStatus @default(PENDING)

  // Audit (GDPR-irrelevant; retained for forensics)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([expiresAt])
  @@map("verification_challenges")
}

// -----------------------------------------------------------------------------
// Source + verification
// -----------------------------------------------------------------------------

model Source {
  id          String  @id @default(cuid()) // src_<ulid>
  creatorId   String
  title       String
  url         String
  domain      String
  description String?

  // Pricing (atomic USDC; default $0.001 per citation)
  citationPrice String  @default("1000")
  minPayout     String  @default("100")
  periodCap     String?
  license       String  @default("all-rights-reserved")

  // Verification (real DNS/HTML/file in Phase 2 P2-012)
  status     SourceStatus @default(PENDING_VERIFICATION)
  verifiedAt DateTime?

  // Aggregates (denormalized, refreshed by a worker in Phase 6+)
  citationCount Int    @default(0)
  earnedAtomic  String @default("0")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  creator       Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  verifications SourceVerification[]
  fingerprints  Fingerprint[]
  citations     Citation[]
  payments      Payment[]

  @@unique([creatorId, url])
  @@index([creatorId, status])
  @@index([domain])
  @@index([status])
  @@map("sources")
}

model SourceVerification {
  id            String                   @id @default(cuid()) // ver_<ulid>
  sourceId      String
  method        SourceVerificationMethod
  status        VerificationStatus              @default(PENDING)
  token         String // DNS TXT or HTML meta tag value
  expected      String // what we expected the creator to publish
  observed      String? // what we actually saw
  attempts      Int                      @default(0)
  lastTriedAt   DateTime?
  succeededAt   DateTime?
  failureReason String?
  createdAt     DateTime                 @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, method])
  @@index([status])
  @@map("source_verifications")
}

// Phase 3 — Fingerprints used by the citation engine for snippet-hash matching.
// Phase 0/2 had Sources registered only by URL/domain. The Engine now also
// stores rolling content fingerprints (SHA-256 of normalized body slices) so
// we can match citations that *quote* the source without a verbatim URL.
model Fingerprint {
  id         String   @id @default(cuid()) // fp_<ulid>
  sourceId   String
  algorithm  String // "SHA-256-NORM" for v1
  hash       String // the fingerprint hash itself (hex)
  window     Int // character offset window the fingerprint covers
  body       String? // optional: stored body slice for QA / fraud replay
  observedAt DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, algorithm, hash])
  @@index([hash])
  @@map("fingerprints")
}

// -----------------------------------------------------------------------------
// Citation (Phase 3 implements the pipeline; MVP currently simulates)
// -----------------------------------------------------------------------------

model Citation {
  id         String  @id @default(cuid()) // cit_<ulid>
  sourceId   String
  responseId String?
  snippet    String

  // Phase 3 — what matched
  kind                 CitationKind @default(DIRECT)
  matchKind            String       @default("URL") // "URL" | "FINGERPRINT" | "QUOTE"
  matchScore           String       @default("1.0000")
  confidence           String       @default("1.00")
  contributionFraction String       @default("1.0000")
  payoutAmountUsdc     String       @default("1000")
  status               String       @default("PENDING")
  recordedAt           DateTime     @default(now())

  // Append-only hash chain (Phase 3 P3-008)
  prevHash String?
  hash     String?

  source   Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  creators Creator[] @relation("CreatorCitations")

  @@index([sourceId])
  @@index([responseId])
  @@index([recordedAt])
  @@index([matchKind])
  @@map("citations")
}

// -----------------------------------------------------------------------------
// Payment (Phase 4 implements the engine; MVP currently simulates)
// -----------------------------------------------------------------------------

model Payment {
  id         String        @id @default(cuid()) // pay_<ulid>
  creatorId  String
  sourceId   String?
  amountUsdc String
  currency   String        @default("USDC")
  network    String        @default("ARC_TESTNET")
  status     PaymentStatus @default(SETTLED)

  txHash      String?
  arcScanUrl  String?
  blockNumber BigInt?
  settledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prevHash String?
  hash     String?

  creator           Creator          @relation("CreatorPayments", fields: [creatorId], references: [id], onDelete: Cascade)
  source            Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  paymentRequests   PaymentRequest[] @relation("PaymentToRequest")
  settlementProof   SettlementProof?  @relation("PaymentToProof")

  @@index([creatorId, settledAt])
  @@index([status])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// ApiKey (P2-013 — bearer-token auth for agent integration)
// -----------------------------------------------------------------------------

model ApiKey {
  id             String        @id @default(cuid()) // key_<ulid>
  organizationId String?
  creatorId      String?
  name           String
  prefix         String        @unique // "np_live_<8>" — public, used in lists
  hash           String // bcrypt of "np_live_<prefix>.<secret>"
  last4          String // last 4 chars of secret, for human ID
  scopes         ApiKeyScope[] @default([READ_CITATIONS])
  isActive       Boolean       @default(true)

  expiresAt          DateTime?
  lastUsedAt         DateTime?
  lastUsedIp         String?
  callCount          BigInt    @default(0)
  rateLimitPerMinute Int       @default(600)
  rateLimitBurst     Int       @default(100)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  revokedAt     DateTime?
  revokedReason String?

  creator      Creator?      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([creatorId, isActive])
  @@index([organizationId, isActive])
  @@map("api_keys")
}

// -----------------------------------------------------------------------------
// Idempotency keys (P2-017 — replay-safe POSTs)
// -----------------------------------------------------------------------------

model IdempotencyKey {
  // PK is the client-supplied Idempotency-Key header (UUID typically).
  key            String  @id
  creatorId      String?
  organizationId String?

  method         String // POST /v1/...
  path           String
  requestHash    String // sha256 of the request body
  responseStatus Int?
  responseBody   Json?

  state       String // "IN_FLIGHT" | "COMPLETED" | "FAILED"
  createdAt   DateTime  @default(now())
  expiresAt   DateTime // 24h after creation
  completedAt DateTime?

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// =============================================================================
// PHASE 8 — x402 Payment Protocol + Arc Settlement Proof + ArcScan Verification
// =============================================================================
//
// x402 (Coinbase open standard) — HTTP 402 Payment Required for nano-payments.
//   Spec: https://www.x402.org/
//   Headers: PAYMENT-REQUIRED (server -> client, base64-encoded challenge)
//            PAYMENT-SIGNATURE (client -> server, base64-encoded signed auth)
//            PAYMENT-RESPONSE (server -> client, settlement confirmation)
//
// Arc testnet:
//   RPC:       https://rpc.testnet.arc.network
//   Chain ID:  5042002
//   USDC:      0x3600000000000000000000000000000000000000 (ERC-20 interface, 6 decimals)
//   Explorer:  https://testnet.arcscan.app
//   ArcScan API (Blockscout v2): https://testnet.arcscan.app/api/v2
//
// New models:
//   PaymentRequest      — x402 payment challenge (the 402 response payload)
//   SettlementProof     — immutable onchain settlement receipt for a Payment
//   VerificationEvent   — append-only log of every ArcScan verification attempt
//   Supporter           — payer (AI agent or human wallet) aggregate
//   ProtocolMetrics     — singleton protocol-wide counters
//
// -----------------------------------------------------------------------------
// PaymentRequest — x402 payment challenge
//
// One PaymentRequest is created per 402 challenge. Carries the exact terms
// (amount, recipient, network, asset) the client must sign against, plus
// the EIP-3009 nonce + validity window. The `x402Challenge` JSON column is
// what gets base64-encoded into the `PAYMENT-REQUIRED` response header.
//
// Status lifecycle:
//   QUOTED      -> emitted to client
//   AUTHORIZED  -> client returned signed PAYMENT-SIGNATURE
//   SETTLED     -> onchain settlement observed, SettlementProof created
//   EXPIRED     -> validBefore passed without settlement
//   FAILED      -> settlement attempted but reverted / nonce conflict
// -----------------------------------------------------------------------------

model PaymentRequest {
  id           String              @id @default(cuid()) // "preq_<ulid>"
  creatorId    String
  resource     String              // URI being paid for, e.g. "/v1/research/answer"
  resourceId   String?             // optional FK to citation/source/etc.
  description  String?

  // Payment terms (the actual x402 challenge payload)
  amountUsdc   String              // atomic units, e.g. "10000" = $0.01
  currency     String              @default("USDC")
  network      String              @default("ARC_TESTNET")
  chainId      Int                 @default(5042002)
  assetAddress String              @default("0x3600000000000000000000000000000000000000")
  payTo        String              // settlement destination (creator's wallet)
  facilitator  String              @default("0x0000000000000000000000000000000000000000")

  // EIP-3009 validity window
  validAfter   BigInt              @default(0)
  validBefore  BigInt              // unix seconds
  nonce        String              @unique // 32-byte hex, EIP-3009 nonce

  // x402 envelope (the actual challenge JSON the server returns)
  x402Challenge Json

  // Lifecycle
  status       PaymentRequestStatus @default(QUOTED)
  paymentId    String?             @unique // -> Payment.id when settled

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  quotedAt     DateTime?
  authorizedAt DateTime?
  settledAt    DateTime?
  expiredAt    DateTime?

  creator      Creator             @relation("CreatorPaymentRequests", fields: [creatorId], references: [id], onDelete: Cascade)
  payment      Payment?            @relation("PaymentToRequest", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([status, createdAt])
  @@map("payment_requests")
}

enum PaymentRequestStatus {
  QUOTED       // 402 emitted, awaiting client signature
  AUTHORIZED   // client returned PAYMENT-SIGNATURE
  SETTLED      // onchain settlement confirmed
  EXPIRED      // validBefore passed
  FAILED       // settlement failed (revert, bad signature, etc.)
}

// -----------------------------------------------------------------------------
// SettlementProof — immutable onchain settlement receipt for a Payment
//
// Created immediately after the facilitator confirms a transferWithAuthorization
// on Arc. Carries the onchain evidence (txHash, blockNumber, arcScanUrl) plus
// the verification status from ArcScan. Once created, never mutated (only
// `verificationStatus` advances via separate VerificationEvent rows + a
// trigger that locks the row after SETTLED).
// -----------------------------------------------------------------------------

model SettlementProof {
  id                   String                @id @default(cuid()) // "sprf_<ulid>"
  paymentId            String                @unique
  paymentHash          String                @unique // sha256(canonical payment payload)
  txHash               String                @unique
  blockNumber          BigInt
  blockTimestamp       DateTime
  blockHash            String?
  arcScanUrl           String
  facilitator          String
  network              String                @default("ARC_TESTNET")
  chainId              Int                   @default(5042002)

  // Settlement terms (denormalized for immutable record)
  amountUsdc           String
  assetAddress         String
  payerAddress         String                // supporter / AI agent
  payeeAddress         String                // creator's settlement wallet
  nonce                String

  // Verification state
  verificationStatus   SettlementVerificationStatus    @default(PENDING)
  confirmedAt          DateTime?
  verificationAttempts Int                   @default(0)
  lastCheckedAt        DateTime?

  // Hash chain (tamper-evident link to previous SettlementProof for this creator)
  prevHash             String
  hash                 String                @unique // sha256(prevHash + this canonical body)

  // Lifecycle
  createdAt            DateTime              @default(now())

  payment              Payment               @relation("PaymentToProof", fields: [paymentId], references: [id], onDelete: Cascade)
  events               VerificationEvent[]

  @@index([verificationStatus, createdAt])
  @@index([txHash])
  @@index([blockNumber])
  @@map("settlement_proofs")
}

enum SettlementVerificationStatus {
  PENDING       // awaiting first ArcScan check
  VERIFIED      // ArcScan confirms tx is mined + success
  FAILED        // ArcScan returns failure / tx not found / revert
  INCONCLUSIVE  // network issues; needs retry
}

// -----------------------------------------------------------------------------
// VerificationEvent — append-only log of every verification attempt
//
// One row per verification call (every /payments/verify/:id hit, every
// background re-check). Used to show the timeline in the UI.
// -----------------------------------------------------------------------------

model VerificationEvent {
  id           String              @id @default(cuid()) // "vev_<ulid>"
  proofId      String
  txHash       String
  status       String              // "VERIFIED" | "FAILED" | "INCONCLUSIVE" | "ERROR"
  confirmations Int
  source       String              // "ARCSCAN" | "ONCHAIN" | "HASH_CHAIN"
  payload      Json
  blockNumber  BigInt?
  errorMessage String?

  checkedAt    DateTime            @default(now())

  proof        SettlementProof     @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId, checkedAt])
  @@index([status, checkedAt])
  @@map("verification_events")
}

// -----------------------------------------------------------------------------
// Supporter — payer aggregate (AI agent or human wallet)
//
// Aggregates `totalPaid`, `totalPayments`, and timestamps per unique
// supporter wallet address. Updated atomically on each settlement.
// -----------------------------------------------------------------------------

model Supporter {
  id              String    @id @default(cuid()) // "sup_<ulid>"
  address         String    @unique // wallet address (lowercase)
  totalPaid       String    @default("0") // atomic USDC
  totalPayments   Int       @default(0)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  // Optional metadata
  userAgent       String?   // "Mozilla/5.0..." or "axios/1.x"
  label           String?   // optional human/agent label
  metadata        Json      @default("{}")

  @@index([totalPaid])
  @@map("supporters")
}

// -----------------------------------------------------------------------------
// ProtocolMetrics — singleton protocol-wide counters
//
// Always id="protocol_metrics_singleton". Updated transactionally on every
// settlement via a service-layer upsert. Powers the dashboard metrics cards.
// -----------------------------------------------------------------------------

model ProtocolMetrics {
  id                    String   @id @default("protocol_metrics_singleton")
  totalPayments         BigInt   @default(0)
  totalSettlements      BigInt   @default(0)
  totalVerifications    BigInt   @default(0)
  totalVerified         BigInt   @default(0)
  totalFailed           BigInt   @default(0)
  totalUsdcDistributed  String   @default("0") // atomic USDC
  totalFeesCollected    String   @default("0")
  uniqueSupporters      Int      @default(0)
  uniqueCreators        Int      @default(0)
  x402ChallengesServed  BigInt   @default(0)
  x402PaymentsSettled   BigInt   @default(0)
  lastSettlementAt      DateTime?
  lastVerifiedAt        DateTime?
  updatedAt             DateTime @updatedAt

  @@map("protocol_metrics")
}

// -----------------------------------------------------------------------------
// User — authenticated account (email OTP login)
//
// One row per email. Holds role (creator | supporter) and links to either the
// Creator or Supporter record that represents this user on the protocol.
// Created lazily on first call to /auth/onboard. The web app stores the
// display name and role locally too, so the demo works offline.
// -----------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  role          String
  displayName   String?
  walletAddress String?
  creatorId     String?
  supporterId   String?
  lastLoginAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@map("users")
}
